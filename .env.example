# Namma Ooru Workers - Environment Configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.

# --- Runtime ---
NODE_ENV="development"

# APP_URL: this service's own deployment URL
APP_URL="http://localhost:3000"

# PUBLIC_APP_URL: the public https address workers open reset links on, e.g.
# https://your-domain.example (no trailing slash). Used to build admin-issued
# password-reset links (https://<PUBLIC_APP_URL>/reset-password#token=...).
# Falls back to APP_URL if unset. In production it MUST be https:// or link
# generation is refused.
PUBLIC_APP_URL=""

# Validity of an admin-issued reset link in minutes (5-1440, default 30).
RECOVERY_LINK_TTL_MINUTES="30"

# FRONTEND_URL: origin allowed to call the API with credentials (CORS).
# Same as APP_URL for this single-server setup; set to your real deployed
# frontend origin in production if the frontend is ever split out.
FRONTEND_URL="http://localhost:3000"

# --- Database ---
# REQUIRED. MongoDB Atlas (or local MongoDB) connection string. The server
# refuses to start without this set - see server/mongo.ts.
#   Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/namma_ooru_workers
#   Local example: mongodb://localhost:27017/namma_ooru_workers
MONGODB_URI=""

# --- Security / Sessions ---
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without this set (min 32 characters).
JWT_SECRET=""

# --- Google Authentication ("Continue with Google") ---
# Server-side OAuth 2.0 / OpenID Connect (authorization-code flow + PKCE). See docs/GOOGLE_AUTH.md for the
# Google Cloud Console setup. All three are required; if any is empty the feature is simply switched off
# (the button is shown disabled - nothing is faked).
#   GOOGLE_CLIENT_ID      OAuth client id (not secret, but keep it server-side too)
#   GOOGLE_CLIENT_SECRET  SERVER ONLY. Never put it in a VITE_ variable or commit it.
#   GOOGLE_CALLBACK_URL   Must be EXACTLY the "Authorized redirect URI" registered in Google Cloud, and must end in
#                         /api/auth/google/callback, e.g. https://your-domain.example/api/auth/google/callback
#                         (https required in production; http://localhost:3000/... is accepted for local development).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""
# VITE_GOOGLE_CLIENT_ID is no longer used (no Google script runs in the browser) and can be removed from your .env.

# --- Email (OTP, verification, password reset, notifications) ---
# REQUIRED in production (server refuses to send OTP emails without this
# configured and returns a clear error instead of pretending success).
# In development, OTPs are delivered via the in-app "simulated email"
# notification drawer instead - these variables are not needed for local dev.
# Works with any SMTP-compatible provider: SendGrid, Mailgun, Amazon SES,
# Postmark, Gmail SMTP, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Namma Ooru Workers <no-reply@nammaooruworkers.com>"

# --- Gemini AI-powered worker search (optional) ---
# SERVER-SIDE ONLY. Never put this in a VITE_* variable or in frontend code.
# Without a key the search box still works (dictionary + plain text search).
GEMINI_API_KEY=""
# Model id (verified against Google's official model docs; see README "AI search").
# Fallback option if you prefer the previous Flash-Lite: gemini-3.1-flash-lite
GEMINI_MODEL="gemini-3.5-flash-lite"
# Used once, automatically, only if Google says the model above does not exist (empty = disabled)
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
# Optional tuning (defaults shown). Set AI_SEARCH_ENABLED=false to switch Gemini off.
AI_SEARCH_ENABLED="true"
AI_SEARCH_TIMEOUT_MS="8000"
AI_SEARCH_CACHE_TTL_SECONDS="600"
AI_SEARCH_MIN_CHARS="4"
AI_SEARCH_PER_IP_PER_MINUTE="12"
AI_SEARCH_GLOBAL_PER_MINUTE="120"

# --- Admin bootstrap ---
# REQUIRED in production. If unset in development, a random one-time
# password is generated and printed to the server console on startup -
# it is never written to disk or into this file.
ADMIN_EMAIL="admin@nammaooruworkers.com"
ADMIN_PASSWORD=""

# --- Public search launch scope (server-side) ---
# Comma-separated district ids (see src/data/tamilNaduData.ts) whose workers are
# publicly searchable. Defaults to Salem only. Add ids later (e.g. salem,coimbatore)
# to open more districts - no code change needed.
ENABLED_DISTRICTS=salem

# --- Tests (optional) ---
# Real-MongoDB integration test. Database name MUST end with _test.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/namma_ooru_test
